# ==============================================================================
# BAYAGENTS .GITIGNORE
# ==============================================================================

# --- Environment & Secrets ---
.env
**/.env
*.env
*.env.local
!**/.env.example

# --- Python Virtual Environments ---
.venv/
**/.venv/
venv/
**/venv/
ENV/
**/ENV/

# --- Python Bytecode & Cache ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# --- Runtime, State & Cursor Files ---
**/.kernel_cursor
**/.last_boot_time
*.log
*.pid
*.sock
*.tmp
*.bak

# --- Operating System & Editor Artifacts ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Node / Build Artifacts (bila ada) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Implementation Plans (Local Only) ---
data/plans/*
!data/plans/.gitkeep

