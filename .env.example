# ==============================================================================
# BAYAGENTS MASTER CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi .env dan sesuaikan dengan mesin Anda:
#   cp .env.example .env
# ==============================================================================

# User & Group Linux yang menjalankan proses (misal: bay, masbay, ubuntu)
BAY_USER=bay
BAY_GROUP=bay

# Lokasi direktori instalasi bayagents (Bisa di partisi mana saja)
BAYAGENTS_DIR=/opt/bayagents

# Direktori kerja repositori / proyek (Tempat workspace source code)
WORKSPACE_DIR=/home/bay

# Subdirektori & File Persistence (Opsional; otomatis jika dikosongkan)
DATA_DIR=/opt/bayagents/data
KANBAN_PATH=/opt/bayagents/data/kanban.json
PROJECTS_PATH=/opt/bayagents/data/projects.json
CONFIGS_DIR=/opt/bayagents/configs
SCRIPTS_DIR=/opt/bayagents/scripts
TELEBOT_DIR=/opt/bayagents/telebot

# BayOffice Web Service
BAYOFFICE_HOST=0.0.0.0
BAYOFFICE_PORT=8888
BAYOFFICE_SECRET_KEY=ganti_dengan_random_secret_key_anda
ADMIN_USERNAME=bay
ADMIN_PASSWORD=ganti_dengan_password_anda

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ALLOWED_USER_ID=YOUR_TELEGRAM_USER_ID_HERE

# Tmux Orchestration
TMUX_SESSION_NAME=agy_agents

# 9Router AI & Gateway (Server 146)
ROUTER9_BASE_URL=http://192.168.100.146:20128/v1
ROUTER9_MODEL=gemini-free-smart
ROUTER9_API_KEY=YOUR_ROUTER9_API_KEY_HERE
